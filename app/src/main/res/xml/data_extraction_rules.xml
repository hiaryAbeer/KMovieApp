<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The TMDB session_id is a credential: never back it up or move it to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
