<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="240dp"
    android:layout_height="135dp"
    android:layout_marginHorizontal="@dimen/spacing_s"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp"
    app:shapeAppearance="@style/ShapeAppearance.KMovie.Card"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/backdrop"
        tools:ignore="ContentDescription"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_placeholder" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_medium"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/spacing_s"
        android:paddingTop="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_s"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="How to Train Your Dragon" />
</com.google.android.material.card.MaterialCardView>
