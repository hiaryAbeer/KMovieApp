<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="vm"
            type="com.abeerapps.kmovieapp.ui.MovieViewModel" />

        <variable
            name="model"
            type="com.abeerapps.kmovieapp.domain.MovieModel" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="162dp"
        android:layout_height="262dp"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle_raw_13"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:textDirection="ltr">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="182dp"
            app:cardCornerRadius="13dp"
            android:onClick="@{() -> vm.selectMovie(model)}">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/raw_movies_movie"
                android:layout_width="match_parent"
                android:scaleType="centerCrop"
                android:layout_height="182dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/raw_movies_name"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLength="10"
            android:text="@{model.title}"
            android:textColor="@color/raw_text_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/raw_movies_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_color_b"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/raw_movies_rate"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_weight="0"
                android:text="@{String.valueOf(model.voteAverage)}"
                android:fontFamily="@font/poppins_medium"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/raw_movies_review"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@{String.valueOf(model.popularity) + ` Review`}"
                android:fontFamily="@font/poppins_regular"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/raw_movies_like"
                android:layout_width="18dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:layout_weight="0"
                android:src="@drawable/heart_1" />

        </LinearLayout>

    </LinearLayout>
</layout>