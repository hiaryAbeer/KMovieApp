<resources>

    <!-- Day/night: neutral colors flip via values-night/colors.xml. -->
    <style name="Theme.KMovieApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_yellow</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_yellow_light</item>
        <item name="colorOnPrimaryContainer">@color/on_brand</item>
        <item name="colorSecondary">@color/text_color_a</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_color_a</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KMovie.Dialog</item>
    </style>

    <!-- Yellow text buttons are unreadable on a light dialog, so dialogs use the dark brand color. -->
    <style name="ThemeOverlay.KMovie.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/text_color_a</item>
    </style>

    <style name="TextAppearance.KMovie.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShapeAppearance.KMovie.DetailsHeader" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>

    <style name="ShapeAppearance.KMovie.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
